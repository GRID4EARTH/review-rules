ub.com/users/keewis/subscriptions", "organizations_url": "https://api.github.com/users/keewis/orgs", "repos_url": "https://api.github.com/users/keewis/repos", "events_url": "https://api.github.com/users/keewis/events{/privacy}", "received_events_url": "https://api.github.com/users/keewis/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "", "state": "COMMENTED", "html_url": "https://github.com/GRID4EARTH/healpix-geo/pull/27#pullrequestreview-2858967500", "pull_request_url": "https://api.github.com/repos/GRID4EARTH/healpix-geo/pulls/27", "author_association": "MEMBER", "_links": {"html": {"href": "https://github.com/GRID4EARTH/healpix-geo/pull/27#pullrequestreview-2858967500"}, "pull_request": {"href": "https://api.github.com/repos/GRID4EARTH/healpix-geo/pulls/27"}}, "submitted_at": "2025-05-21T20:00:42Z", "commit_id": "e2bd9878e836c1092b11a5e775c06604c39e5bf4"}, {"id": 2868788568, "node_id": "PRR_kwDON3RSpc6q_j1Y", "user": {"login": "keewis", "id": 14808389, "node_id": "MDQ6VXNlcjE0ODA4Mzg5", "avatar_url": "https://avatars.githubusercontent.com/u/14808389?v=4", "gravatar_id": "", "url": "https://api.github.com/users/keewis", "html_url": "https://github.com/keewis", "followers_url": "https://api.github.com/users/keewis/followers", "following_url": "https://api.github.com/users/keewis/following{/other_user}", "gists_url": "https://api.github.com/users/keewis/gists{/gist_id}", "starred_url": "https://api.github.com/users/keewis/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/keewis/subscriptions", "organizations_url": "https://api.github.com/users/keewis/orgs", "repos_url": "https://api.github.com/users/keewis/repos", "events_url": "https://api.github.com/users/keewis/events{/privacy}", "received_events_url": "https://api.github.com/users/keewis/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "It looks like the `moc` library only panics in debug mode, so if you pass `--release` to `cargo` / `maturin` the issue with polygon edges along meridians should disappear (but this will be fixed in the `moc` library).\r\n\r\nI'm currently looking at a `RangeMOC`-based `xarray` index in #31 that would allow opening / decoding a dataset with a larger-than-memory `cell_ids` coordinate, so I might rebase this PR based on that (we'd basically create a `RangeMOCIndex` from the polygon and then compute the intersection).\r\n\r\nI guess that means that this PR will stay on hold while I try to figure that out (and while I did make some suggestions, those are definitely not urgent).", "state": "COMMENTED", "html_url": "https://github.com/GRID4EARTH/healpix-geo/pull/27#pullrequestreview-2868788568", "pull_request_url": "https://api.github.com/repos/GRID4EARTH/healpix-geo/pulls/27", "author_association": "MEMBER", "_links": {"html": {"href": "https://github.com/GRID4EARTH/healpix-geo/pull/27#pullrequestreview-2868788568"}, "pull_request": {"href": "https://api.github.com/repos/GRID4EARTH/healpix-geo/pulls/27"}}, "submitted_at": "2025-05-27T16:06:06Z", "commit_id": "19f3a00e9f14f3f663b4843f56046a556288e9f1"}]
+        level: int,
+        dim: str,
+        name: str,
+        *,
+        options: Mapping[str, Any],
+    ) -> Self:
+        """Create the index for the complete domain of the given level"""
+        size = 12 * 4**level
+        indexing_scheme = options.get("indexing_scheme", "nested")
+        if indexing_scheme == "zuniq":
+            start = 1 << 2 * (29 - level)
+            step = start << 1
+            stop = size * step
+            cell_ids = pd.RangeIndex(start, stop, step)

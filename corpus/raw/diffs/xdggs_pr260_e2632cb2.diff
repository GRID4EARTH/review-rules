+        else:
+            cell_ids = pd.RangeIndex(size)
+        dict_options = dict(options)
+        dict_options.update(level=level)
+        index_kind = dict_options.pop("index_kind", None)
+        grid_info = HealpixInfo.from_dict(dict_options)
+        return cls(

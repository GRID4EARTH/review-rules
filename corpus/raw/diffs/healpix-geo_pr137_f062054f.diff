+from healpix_geo.nested import siblings, healpix_to_lonlat
+
+depth = 3
+ipix = np.array([42], dtype=np.uint64)
+
+# Get siblings
+sib = siblings(ipix, depth)
+
+# Get coordinates
+lon_sib, lat_sib = healpix_to_lonlat(sib, depth, ellipsoid="sphere")

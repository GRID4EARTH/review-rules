[{"id": 4843648379, "node_id": "PRR_kwDON3RSpc8AAAABILQ1ew", "user": {"login": "keewis", "id": 14808389, "node_id": "MDQ6VXNlcjE0ODA4Mzg5", "avatar_url": "https://avatars.githubusercontent.com/u/14808389?v=4", "gravatar_id": "", "url": "https://api.github.com/users/keewis", "html_url": "https://github.com/keewis", "followers_url": "https://api.github.com/users/keewis/followers", "following_url": "https://api.github.com/users/keewis/following{/other_user}", "gists_url": "https://api.github.com/users/keewis/gists{/gist_id}", "starred_url": "https://api.github.com/users/keewis/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/keewis/subscriptions", "organizations_url": "https://api.github.com/users/keewis/orgs", "repos_url": "https://api.github.com/users/keewis/repos", "events_url": "https://api.github.com/users/keewis/events{/privacy}", "received_events_url": "https://api.github.com/users/keewis/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "thanks for the PR, this is great.\n\nI've added a few comments after reviewing the code, but will go through your long post tomorrow and respond to your questions (though I believe some of them are already answered in the review comments).", "state": "COMMENTED", "html_url": "https://github.com/GRID4EARTH/healpix-geo/pull/234#pullrequestreview-4843648379", "pull_request_url": "https://api.github.com/repos/GRID4EARTH/healpix-geo/pulls/234", "author_association": "MEMBER", "_links": {"html": {"href": "https://github.com/GRID4EARTH/healpix-geo/pull/234#pullrequestreview-4843648379"}, "pull_request": {"href": "https://api.github.com/repos/GRID4EARTH/healpix-geo/pulls/234"}}, "submitted_at": "2026-08-03T15:23:58Z", "commit_id": "d84ccaff7b91243bf08751b6e399eed16432565b"}, {"id": 4852439609, "node_id": "PRR_kwDON3RSpc8AAAABITpaOQ", "user": {"login": "keewis", "id": 14808389, "node_id": "MDQ6VXNlcjE0ODA4Mzg5", "avatar_url": "https://avatars.githubusercontent.com/u/14808389?v=4", "gravatar_id": "", "url": "https://api.github.com/users/keewis", "html_url": "https://github.com/keewis", "followers_url": "https://api.github.com/users/keewis/followers", "following_url": "https://api.github.com/users/keewis/following{/other_user}", "gists_url": "https://api.github.com/users/keewis/gists{/gist_id}", "starred_url": "https://api.github.com/users/keewis/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/keewis/subscriptions", "organizations_url": "https://api.github.com/users/keewis/orgs", "repos_url": "https://api.github.com/users/keewis/repos", "events_url": "https://api.github.com/users/keewis/events{/privacy}", "received_events_url": "https://api.github.com/users/keewis/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "some more comments, and some responses to your post:\n- `healpix-geo-wasm` is experimental, so we don't need deprecation cycles for breaking changes\n- I didn't know WASM objects needed to be `free()`d. I guess that means I'm leaving it up to the `FinalizationRegistry` to clean up those objects\n- it's fine to change the signature of the functions that take it to `&Ellipsoid`\n- `parseEllipsoid` can be removed\n- `createGrid` was the proposal in the review of the gridlook PR, but if you believe that `new Grid(...)` is the more idiomatic way I think it's fine to go with that\n- the names `center` and `cellAt` are significantly different from the ones of the python bindings, which in turn are taken from `cds-healpix-python`. I'm inclined (but could be convinced otherwise) to follow that naming scheme, since `healpix-geo-wasm` are JS bindings for the `healpix-geo` rust crate.\n- if we go with a grid object I don't think we need to also support hybrids (plain objects plus ellipsoid handles)\n- it's fine to use the current implementation: we don't really support `nside` that are not powers of two, so there's no benefit with going through the functionality in `healpix_geo_core::scalar::ring`\n- type checking of the `*.d.ts` files would be nice\n- `vertices`: how bad is the memory allocation if we do this in a more vectorized way? Right now, we pass a single cell id to `vertices`, but this could just as well return the vertices for multiple cells, and thus we just need to chunk the cells appropriately. Though if this not a bottleneck right now I agree that we can skip this optimization for now.", "state": "COMMENTED", "html_url": "https://github.com/GRID4EARTH/healpix-geo/pull/234#pullrequestreview-4852439609", "pull_request_url": "https://api.github.com/repos/GRID4EARTH/healpix-geo/pulls/234", "author_association": "MEMBER", "_links": {"html": {"href": "https://github.com/GRID4EARTH/healpix-geo/pull/234#pullrequestreview-4852439609"}, "pull_request": {"href": "https://api.github.com/repos/GRID4EARTH/healpix-geo/pulls/234"}}, "submitted_at": "2026-08-04T11:45:17Z", "commit_id": "d84ccaff7b91243bf08751b6e399eed16432565b"}, {"id": 4901784932, "node_id": "PRR_kwDON3RSpc8AAAABJCtNZA", "user": {"login": "espg", "id": 3896161, "node_id": "MDQ6VXNlcjM4OTYxNjE=", "avatar_url": "https://avatars.githubusercontent.com/u/3896161?u=3e2701e177fd286fcd853cb4d1cb727e80b1aabc&v=4", "gravatar_id": "", "url": "https://api.github.com/users/espg", "html_url": "https://github.com/espg", "followers_url": "https://api.github.com/users/espg/followers", "following_url": "https://api.github.com/users/espg/following{/other_user}", "gists_url": "https://api.github.com/users/espg/gists{/gist_id}", "starred_url": "https://api.github.com/users/espg/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/espg/subscriptions", "organizations_url": "https://api.github.com/users/espg/orgs", "repos_url": "https://api.github.com/users/espg/repos", "events_url": "https://api.github.com/users/espg/events{/privacy}", "received_events_url": "https://api.github.com/users/espg/received_events", "type": "User", "user_view_type": "public", "site_a